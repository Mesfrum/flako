# Copy to .env next to compose.yaml on the server.
# Your domain, or <public-ip-with-dashes>.sslip.io if you have no domain (e.g. 203-0-113-7.sslip.io).
DOMAIN=notes.example.com

# Optional: Litestream backups to Cloudflare R2 (see DEPLOY.md). All four set = backups on;
# leave them commented out (or any one empty) = backups off. Never commit a filled-in .env.
# R2_ACCOUNT_ID=
# R2_BUCKET=flako-db
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
